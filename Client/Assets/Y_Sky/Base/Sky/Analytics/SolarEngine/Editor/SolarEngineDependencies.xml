<?xml version="1.0" encoding="utf-8"?>
<!--
  【新增】热力引擎（SolarEngine / 热云）Android SDK 依赖配置。
  数据区域：海外（com.reyun.solar.engine.oversea）  
  通过 EDM4U（External Dependency Manager for Unity）注入 Maven 仓库与依赖坐标，
  与现有 Adjust（Assets/Adjust/Native/Editor/Dependencies.xml）的接入方式一致。
  解析入口：Unity 菜单 Assets → External Dependency Manager → Android Resolver → Force Resolve
  备用仓库（主仓库不可用时切换）：https://maven-android-cn.solar-engine.com/repository/se_sdk_for_android/
-->
<dependencies>
    <androidPackages>
        <repositories>
            <!-- 热云海外 SDK 主仓库 -->
            <repository>https://maven-android.solar-engine.com/repository/se_sdk_for_android/</repository>
            <!-- 华为 / 荣耀仓库：热云内部依赖了 OAID 库，不加会拉取失败 -->
            <repository>https://developer.huawei.com/repo/</repository>
            <repository>https://developer.hihonor.com/repo/</repository>
        </repositories>
        <androidPackage spec="com.reyun.solar.engine.oversea:solar-engine-core:1.3.2">
        </androidPackage>
    </androidPackages>
</dependencies>
