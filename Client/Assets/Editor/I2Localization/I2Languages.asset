      Languages_Touch: []
    - Term: uitps_guide_tips21
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5F53</color><color=#FFFFFF>\u95E8</color><color=#FFFFFF>\u6253\u5F00\u65F6\u624D\u80FD\u70B9\u51FB\u65B9\u5757.</color>"
      - "<color=#FFFFFF>\u7576</color><color=#FFFFFF>\u9580</color><color=#FFFFFF>\u6253\u958B\u6642\u624D\u80FD\u9EDE\u64CA\u65B9\u584A.</color>"
      - <color=#FFFFFF>You can only tap blocks when the</color><color=#FFFFFF> door</color><color=#FFFFFF>
        is open.</color>
      - "<color=#FFFFFF>Du kannst nur auf Bl\xF6cke tippen, wenn die</color><color=#FFFFFF>
        T\xFCr</color><color=#FFFFFF> offen ist.</color>"
      - "<color=#FFFFFF>\u30C9\u30A2</color><color=#FFFFFF>\u304C\u958B\u3044\u3066\u3044\u308B\u6642\u3060\u3051\u30D6\u30ED\u30C3\u30AF\u3092\u30BF\u30C3\u30D7\u3067\u304D\u307E\u3059\u3002</color>"
      - "<color=#FFFFFF>\uBB38</color><color=#FFFFFF>\uC774 \uC5F4\uB824 \uC788\uC744
        \uB54C\uB9CC \uBE14\uB85D\uC744 \uD0ED\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</color>"
      - <color=#FFFFFF>Vous ne pouvez appuyer sur les blocs que lorsque la</color><color=#FFFFFF>
        porte</color><color=#FFFFFF> est ouverte.</color>
      - "<color=#FFFFFF>Puoi toccare i blocchi solo quando la</color><color=#FFFFFF>
        porta</color><color=#FFFFFF> \xE8 aperta.</color>"
      - "<color=#FFFFFF>Mo\u017Cesz klika\u0107 bloki tylko wtedy, gdy</color><color=#FFFFFF>
        drzwi</color><color=#FFFFFF> s\u0105 otwarte.</color>"
      - "<color=#FFFFFF>Du kan bara trycka p\xE5 block n\xE4r</color><color=#FFFFFF>
        d\xF6rren</color><color=#FFFFFF> \xE4r \xF6ppen.</color>"
      - "<color=#FFFFFF>Solo puedes tocar bloques cuando la</color><color=#FFFFFF>
        puerta</color><color=#FFFFFF> est\xE1 abierta.</color>"
      - "<color=#FFFFFF>Po\u021Bi s\u0103 ape\u0219i pe blocuri doar c\xE2nd</color><color=#FFFFFF>
        u\u0219a</color><color=#FFFFFF> este deschis\u0103.</color>"
      - "<color=#FFFFFF>M\u016F\u017Eete klepat na bloky pouze tehdy, kdy\u017E jsou</color><color=#FFFFFF>
        dve\u0159e</color><color=#FFFFFF> otev\u0159en\xE9.</color>"
      - "<color=#FFFFFF>\u041D\u0430\u0436\u0438\u043C\u0430\u0442\u044C \u043D\u0430
        \u0431\u043B\u043E\u043A\u0438 \u043C\u043E\u0436\u043D\u043E, \u043A\u043E\u0433\u0434\u0430</color><color=#FFFFFF>
        \u0434\u0432\u0435\u0440\u044C</color><color=#FFFFFF> \u043E\u0442\u043A\u0440\u044B\u0442\u0430.</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips22
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u901A\u8FC7\u79FB\u9664\u76F8\u90BB\u7684\u65B9\u5757\u5207\u6389</color><color=#FFFFFF>\u85E4\u8513</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u900F\u904E\u79FB\u9664\u76F8\u9130\u7684\u65B9\u584A\u5207\u6389</color><color=#FFFFFF>\u85E4\u8513</color><color=#FFFFFF>!</color>"
      - <color=#FFFFFF>Cut the</color><color=#FFFFFF> vine</color><color=#FFFFFF>
        by removing adjacent blocks!</color>
      - "<color=#FFFFFF>Schneide die</color><color=#FFFFFF> Ranke</color><color=#FFFFFF>
