      - "<color=#FFFFFF>3\u3064\u306E\u30D6\u30ED\u30C3\u30AF</color><color=#56A9FF>\u3092\u96C6\u3081\u3066</color><color=#FFFFFF>\u6D88\u53BB\u3057\u3088\u3046\uFF01</color>"
