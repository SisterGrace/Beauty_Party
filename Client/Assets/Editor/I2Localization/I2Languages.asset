    - Term: uitps_guide_tips1
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5173\u5361\u5931\u8D25!\u70B9\u51FB\u6309\u94AE\u5E76</color><color=#56A9FF>\u514D\u8D39</color><color=#FFFFFF>\u7EE7\u7EED!</color>"
