        by removing adjacent blocks!</color>
      - "<color=#FFFFFF>Zerbrich den</color><color=#FFFFFF> Stein</color><color=#FFFFFF>,
        indem du benachbarte Bl\xF6cke entfernst!</color>"
      - "<color=#FFFFFF>\u96A3\u63A5\u3059\u308B\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3057\u3066</color><color=#FFFFFF>\u77F3</color><color=#FFFFFF>\u3092\u58CA\u305D\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC778\uC811\uD55C \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uC5EC</color><color=#FFFFFF>
        \uB3CC</color><color=#FFFFFF>\uC744 \uAE68\uC138\uC694!</color>"
      - <color=#FFFFFF>Cassez la</color><color=#FFFFFF> pierre</color><color=#FFFFFF>
        en retirant les blocs adjacents !</color>
      - <color=#FFFFFF>Rompi la</color><color=#FFFFFF> pietra</color><color=#FFFFFF>
        rimuovendo i blocchi adiacenti!</color>
      - "<color=#FFFFFF>Zniszcz</color><color=#FFFFFF> kamie\u0144</color><color=#FFFFFF>,
        usuwaj\u0105c s\u0105siednie bloki!</color>"
      - <color=#FFFFFF>Bryt</color><color=#FFFFFF> stenen</color><color=#FFFFFF>
        genom att ta bort intilliggande block!</color>
      - "<color=#FFFFFF>\xA1Rompe la</color><color=#FFFFFF> piedra</color><color=#FFFFFF>
        eliminando bloques adyacentes!</color>"
      - "<color=#FFFFFF>Sparge</color><color=#FFFFFF> piatra</color><color=#FFFFFF>
        \xEEndep\u0103rt\xE2nd blocuri adiacente!</color>"
      - "<color=#FFFFFF>Rozbijte</color><color=#FFFFFF> k\xE1men</color><color=#FFFFFF>
        odstran\u011Bn\xEDm sousedn\xEDch blok\u016F!</color>"
      - "<color=#FFFFFF>\u0423\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
        \u0431\u043B\u043E\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u0438\u0442\u044C</color><color=#FFFFFF>
        \u043A\u0430\u043C\u0435\u043D\u044C</color><color=#FFFFFF>!</color>"
