      - "<color=#FFFFFF>Odstra\u0148te</color><color=#FFFFFF> li\xE1nu</color><color=#FFFFFF>
        odstran\u011Bn\xEDm sousedn\xEDch blok\u016F!</color>"
      - "<color=#FFFFFF>\u0423\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
        \u0431\u043B\u043E\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u0441\u0440\u0435\u0437\u0430\u0442\u044C</color><color=#FFFFFF>
        \u043B\u043E\u0437\u0443</color><color=#FFFFFF>!</color>"
