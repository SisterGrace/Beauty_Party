      - "<color=#FFFFFF>Colecteaz\u0103</color><color=#56A9FF> trei blocuri</color><color=#FFFFFF>
        pentru a le elimina!</color>"
      - "<color=#FFFFFF>Shrom\xE1\u017Ed\u011Bte</color><color=#56A9FF> t\u0159i
        bloky</color><color=#FFFFFF> a vy\u010Dist\u011Bte je!</color>"
      - "<color=#FFFFFF>\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435</color><color=#56A9FF>
        \u0442\u0440\u0438 \u0431\u043B\u043E\u043A\u0430</color><color=#FFFFFF>,
        \u0447\u0442\u043E\u0431\u044B \u0443\u0434\u0430\u043B\u0438\u0442\u044C
        \u0438\u0445!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips5
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5E72\u5F97\u597D!\u79FB\u9664\u5269\u4E0B\u76F8\u540C\u56FE\u6848\u7684\u65B9\u5757\u62B5\u8FBE\u7EC8\u70B9\u5427\uFF01</color>"
      - "<color=#FFFFFF>\u5E79\u5F97\u597D!\u79FB\u9664\u5269\u4E0B\u76F8\u540C\u5716\u6848\u7684\u65B9\u584A\u62B5\u9054\u7D42\u9EDE\u5427\uFF01</color>"
      - <color=#FFFFFF>Well done! Remove the remaining blocks with the same pattern
        to reach the finish!</color>
      - "<color=#FFFFFF>Gut gemacht! Entferne die verbleibenden Bl\xF6cke mit demselben
        Muster, um das Ziel zu erreichen!</color>"
      - "<color=#FFFFFF>\u3088\u304F\u3067\u304D\u307E\u3057\u305F\uFF01\u540C\u3058\u30D1\u30BF\u30FC\u30F3\u306E\u6B8B\u308A\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3057\u3066\u30B4\u30FC\u30EB\u306B\u5230\u9054\u3057\u3088\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC798\uD588\uC5B4\uC694! \uAC19\uC740 \uD328\uD134\uC758
        \uB0A8\uC740 \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uC5EC \uACB0\uC2B9\uC810\uC5D0
        \uB3C4\uB2EC\uD558\uC138\uC694!</color>"
      - "<color=#FFFFFF>Bien jou\xE9 ! Retirez les blocs restants avec le m\xEAme
        motif pour atteindre l'arriv\xE9e !</color>"
      - <color=#FFFFFF>Ben fatto! Rimuovi i blocchi rimanenti con lo stesso motivo
        per raggiungere il traguardo!</color>
      - "<color=#FFFFFF>Dobra robota! Usu\u0144 pozosta\u0142e bloki z tym samym
        wzorem, aby dotrze\u0107 do mety!</color>"
      - "<color=#FFFFFF>Bra jobbat! Ta bort de \xE5terst\xE5ende blocken med samma
        m\xF6nster f\xF6r att n\xE5 m\xE5let!</color>"
      - "<color=#FFFFFF>\xA1Bien hecho! \xA1Elimina los bloques restantes con el
        mismo patr\xF3n para llegar a la meta!</color>"
      - "<color=#FFFFFF>Bine lucrat! \xCEndep\u0103rteaz\u0103 blocurile r\u0103mase
        cu acela\u0219i model pentru a ajunge la final!</color>"
      - "<color=#FFFFFF>Dobr\xE1 pr\xE1ce! Odstra\u0148te zb\xFDvaj\xEDc\xED bloky
        se stejn\xFDm vzorem, abyste dos\xE1hli c\xEDle!</color>"
      - "<color=#FFFFFF>\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0423\u0434\u0430\u043B\u044F\u0439\u0442\u0435
        \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0431\u043B\u043E\u043A\u0438
        \u0441 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C \u0440\u0438\u0441\u0443\u043D\u043A\u043E\u043C,
        \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips6
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u901A\u8FC7\u79FB\u9664\u76F8\u90BB\u7684\u65B9\u5757\u6253\u7834</color><color=#56A9FF>\u94FE\u5B50</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u900F\u904E\u79FB\u9664\u76F8\u9130\u7684\u65B9\u584A\u6253\u7834</color><color=#56A9FF>\u93C8\u5B50</color><color=#FFFFFF>!</color>"
      - <color=#FFFFFF>Break the</color><color=#56A9FF> chain</color><color=#FFFFFF>
        by removing adjacent blocks!</color>
      - "<color=#FFFFFF>Zerbrich die</color><color=#56A9FF> Kette</color><color=#FFFFFF>,
        indem du benachbarte Bl\xF6cke entfernst!</color>"
      - "<color=#FFFFFF>\u96A3\u63A5\u3059\u308B\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3057\u3066</color><color=#56A9FF>\u9396</color><color=#FFFFFF>\u3092\u58CA\u305D\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC778\uC811\uD55C \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uC5EC</color><color=#56A9FF>
        \uC0AC\uC2AC</color><color=#FFFFFF>\uC744 \uB04A\uC73C\uC138\uC694!</color>"
      - "<color=#FFFFFF>Brisez la</color><color=#56A9FF> cha\xEEne</color><color=#FFFFFF>
        en retirant les blocs adjacents !</color>"
      - <color=#FFFFFF>Rompi la</color><color=#56A9FF> catena</color><color=#FFFFFF>
        rimuovendo i blocchi adiacenti!</color>
      - "<color=#FFFFFF>Przerwij</color><color=#56A9FF> \u0142a\u0144cuch</color><color=#FFFFFF>,
        usuwaj\u0105c s\u0105siednie bloki!</color>"
      - <color=#FFFFFF>Bryt</color><color=#56A9FF> kedjan</color><color=#FFFFFF>
        genom att ta bort intilliggande block!</color>
      - "<color=#FFFFFF>\xA1Rompe la</color><color=#56A9FF> cadena</color><color=#FFFFFF>
        eliminando bloques adyacentes!</color>"
      - "<color=#FFFFFF>Rupe</color><color=#56A9FF> lan\u021Bul</color><color=#FFFFFF>
        \xEEndep\u0103rt\xE2nd blocuri adiacente!</color>"
      - "<color=#FFFFFF>P\u0159eru\u0161te</color><color=#56A9FF> \u0159et\u011Bz</color><color=#FFFFFF>
        odstran\u011Bn\xEDm sousedn\xEDch blok\u016F!</color>"
      - "<color=#FFFFFF>\u0423\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
        \u0431\u043B\u043E\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C</color><color=#56A9FF>
        \u0446\u0435\u043F\u044C</color><color=#FFFFFF>!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips7
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6309\u4E0B\u4EE5\u64A4\u56DE\u4E0A\u4E00\u4E2A\u64CD\u4F5C!</color>"
      - "<color=#FFFFFF>\u6309\u4E0B\u4EE5\u64A4\u56DE\u4E0A\u4E00\u500B\u64CD\u4F5C!</color>"
      - <color=#FFFFFF>Press to undo the last move!</color>
      - "<color=#FFFFFF>Dr\xFCcke, um den letzten Zug r\xFCckg\xE4ngig zu machen!</color>"
      - "<color=#FFFFFF>\u62BC\u3057\u3066\u6700\u5F8C\u306E\u64CD\u4F5C\u3092\u53D6\u308A\u6D88\u305D\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uB9C8\uC9C0\uB9C9 \uB3D9\uC791\uC744 \uCDE8\uC18C\uD558\uB824\uBA74
        \uB204\uB974\uC138\uC694!</color>"
      - <color=#FFFFFF>Appuyez pour annuler le dernier mouvement !</color>
      - <color=#FFFFFF>Premi per annullare l'ultima mossa!</color>
      - "<color=#FFFFFF>Naci\u015Bnij, aby cofn\u0105\u0107 ostatni ruch!</color>"
      - "<color=#FFFFFF>Tryck f\xF6r att \xE5ngra ditt senaste drag!</color>"
      - "<color=#FFFFFF>\xA1Presiona para deshacer el \xFAltimo movimiento!</color>"
      - "<color=#FFFFFF>Apas\u0103 pentru a anula ultima mi\u0219care!</color>"
      - "<color=#FFFFFF>Stisknut\xEDm vr\xE1t\xEDte posledn\xED tah zp\u011Bt!</color>"
      - "<color=#FFFFFF>\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
        \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips8
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6309\u4E0B\u4EE5\u6253\u4E71\u73A9\u6CD5\u533A\u7684\u6240\u6709\u65B9\u5757!</color>"
      - "<color=#FFFFFF>\u6309\u4E0B\u4EE5\u6253\u4E82\u73A9\u6CD5\u5340\u7684\u6240\u6709\u65B9\u584A!</color>"
      - <color=#FFFFFF>Press to shuffle all blocks in the play area!</color>
      - "<color=#FFFFFF>Dr\xFCcke, um alle Bl\xF6cke im Spielbereich zu mischen!</color>"
      - "<color=#FFFFFF>\u62BC\u3057\u3066\u30D7\u30EC\u30A4\u30A8\u30EA\u30A2\u306E\u3059\u3079\u3066\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u30B7\u30E3\u30C3\u30D5\u30EB\uFF01</color>"
      - "<color=#FFFFFF>\uD50C\uB808\uC774 \uC601\uC5ED\uC758 \uBAA8\uB4E0 \uBE14\uB85D\uC744
        \uC11E\uC73C\uB824\uBA74 \uB204\uB974\uC138\uC694!</color>"
      - "<color=#FFFFFF>Appuyez pour m\xE9langer tous les blocs de la zone de jeu
        !</color>"
      - <color=#FFFFFF>Premi per mescolare tutti i blocchi nell'area di gioco!</color>
      - "<color=#FFFFFF>Naci\u015Bnij, aby przetasowa\u0107 wszystkie bloki w obszarze
        gry!</color>"
      - "<color=#FFFFFF>Tryck f\xF6r att blanda alla block i spelomr\xE5det!</color>"
      - "<color=#FFFFFF>\xA1Presiona para barajar todos los bloques en el \xE1rea
        de juego!</color>"
      - "<color=#FFFFFF>Apas\u0103 pentru a amesteca toate blocurile din zona de
        joc!</color>"
      - "<color=#FFFFFF>Stisknut\xEDm zam\xEDch\xE1te v\u0161echny bloky v hern\xED
        oblasti!</color>"
      - "<color=#FFFFFF>\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C \u0432\u0441\u0435
        \u0431\u043B\u043E\u043A\u0438 \u0432 \u0438\u0433\u0440\u043E\u0432\u043E\u0439
        \u0437\u043E\u043D\u0435!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips9
      TermType: 0
      Description: 
      Languages:
      - "<color=#56A9FF>\u65B9\u5757\u8001\u864E\u673A</color><color=#FFFFFF>\u5C06\u63A8\u51FA\u60A8\u9700\u8981\u7684\u4E09\u5757\u74F7\u7816!</color>"
      - "<color=#56A9FF>\u65B9\u584A\u8001\u864E\u6A5F</color><color=#FFFFFF>\u5C07\u63A8\u51FA\u60A8\u9700\u8981\u7684\u4E09\u584A\u74F7\u78DA!</color>"
      - <color=#56A9FF>Block Slot Machine</color><color=#FFFFFF> will spit out the
        three tiles you need!</color>
      - "<color=#56A9FF>Block-Spielautomat</color><color=#FFFFFF> spuckt die drei
        ben\xF6tigten Kacheln aus!</color>"
      - "<color=#56A9FF>\u30D6\u30ED\u30C3\u30AF\u30B9\u30ED\u30C3\u30C8\u30DE\u30B7\u30F3</color><color=#FFFFFF>\u304C\u3042\u306A\u305F\u304C\u5FC5\u8981\u306A3\u3064\u306E\u30BF\u30A4\u30EB\u3092\u5410\u304D\u51FA\u3057\u307E\u3059\uFF01</color>"
      - "<color=#56A9FF>\uBE14\uB85D \uC2AC\uB86F \uBA38\uC2E0</color><color=#FFFFFF>\uC774
        \uD544\uC694\uD55C \uC138 \uD0C0\uC77C\uC744 \uB0B4\uB193\uC2B5\uB2C8\uB2E4!</color>"
      - "<color=#56A9FF>Machine \xE0 sous de blocs</color><color=#FFFFFF> crachera
        les trois tuiles dont vous avez besoin !</color>"
      - "<color=#56A9FF>Slot Machine di Blocchi</color><color=#FFFFFF> sputer\xE0
        le tre tessere di cui hai bisogno!</color>"
      - "<color=#56A9FF>Automat do blok\xF3w</color><color=#FFFFFF> wyrzuci trzy
        potrzebne p\u0142ytki!</color>"
      - "<color=#56A9FF>Blockspelmaskin</color><color=#FFFFFF> kommer att spotta
        ut de tre brickor du beh\xF6ver!</color>"
      - "<color=#56A9FF>M\xE1quina tragamonedas de bloques</color><color=#FFFFFF>
        \xA1arrojar\xE1 las tres fichas que necesitas!</color>"
      - "<color=#56A9FF>Ma\u0219in\u0103 de blocuri</color><color=#FFFFFF> va scuipa
        cele trei pl\u0103ci de care ai nevoie!</color>"
      - "<color=#56A9FF>Automat na bloky</color><color=#FFFFFF> vyplivne t\u0159i
        dla\u017Edice, kter\xE9 pot\u0159ebujete!</color>"
      - "<color=#56A9FF>\u0411\u043B\u043E\u043A\u043E\u0432\u044B\u0439 \u0441\u043B\u043E\u0442</color><color=#FFFFFF>
        \u0432\u044B\u0434\u0430\u0441\u0442 \u0442\u0440\u0438 \u043D\u0443\u0436\u043D\u044B\u0445
        \u0432\u0430\u043C \u0431\u043B\u043E\u043A\u0430!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips31
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6CA1\u6709\u53EF\u6D88\u9664\u7684\u724C\u7EC4\uFF01</color>"
      - "<color=#FFFFFF>\u6C92\u6709\u53EF\u6D88\u9664\u7684\u724C\u7D44\uFF01</color>"
      - <color=#FFFFFF>There are no eliminable decks!</color>
      - <color=#FFFFFF>Keine eliminierbaren Decks!</color>
      - "<color=#FFFFFF>\u9664\u53BB\u53EF\u80FD\u306A\u30C7\u30C3\u30AD\u306F\u3042\u308A\u307E\u305B\u3093\uFF01</color>"
      - "<color=#FFFFFF>\uC81C\uAC70 \uAC00\uB2A5\uD55C \uB371\uC774 \uC5C6\uC2B5\uB2C8\uB2E4!</color>"
      - "<color=#FFFFFF>Aucun deck \xE9liminable !</color>"
      - <color=#FFFFFF>Nessun deck eliminabile!</color>
      - "<color=#FFFFFF>Brak mo\u017Cliwych do wyeliminowania talii!</color>"
      - <color=#FFFFFF>Inga eliminerbara kortlekar!</color>
      - "<color=#FFFFFF>\xA1No hay mazos eliminables!</color>"
      - "<color=#FFFFFF>Nu exist\u0103 pachete eliminabile!</color>"
      - "<color=#FFFFFF>Nejsou \u017E\xE1dn\xE9 odstraniteln\xE9 bal\xED\u010Dky!</color>"
      - "<color=#FFFFFF>\u041D\u0435\u0442 \u0443\u0434\u0430\u043B\u044F\u0435\u043C\u044B\u0445
        \u043A\u043E\u043B\u043E\u0434!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
