    - Term: uitps_guide_tips18
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u901A\u8FC7\u79FB\u9664\u4E24\u4E2A\u76F8\u90BB\u7684\u65B9\u5757\u64E6\u53BB</color><color=#FFFFFF>\u8702\u871C</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u900F\u904E\u79FB\u9664\u5169\u500B\u76F8\u9130\u7684\u65B9\u584A\u64E6\u53BB</color><color=#FFFFFF>\u8702\u871C</color><color=#FFFFFF>!</color>"
      - <color=#FFFFFF>Erase</color><color=#FFFFFF> honey</color><color=#FFFFFF>
        by removing two adjacent blocks!</color>
      - "<color=#FFFFFF>L\xF6sche</color><color=#FFFFFF> Honig</color><color=#FFFFFF>,
        indem du zwei benachbarte Bl\xF6cke entfernst!</color>"
      - "<color=#FFFFFF>\u96A3\u63A5\u3059\u308B2\u3064\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3057\u3066</color><color=#FFFFFF>\u30CF\u30C1\u30DF\u30C4</color><color=#FFFFFF>\u3092\u6D88\u53BB\u3057\u3088\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC778\uC811\uD55C \uB450 \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uC5EC</color><color=#FFFFFF>
        \uAFC0</color><color=#FFFFFF>\uC744 \uC9C0\uC6B0\uC138\uC694!</color>"
      - <color=#FFFFFF>Effacez le</color><color=#FFFFFF> miel</color><color=#FFFFFF>
        en retirant deux blocs adjacents !</color>
      - <color=#FFFFFF>Cancella il</color><color=#FFFFFF> miele</color><color=#FFFFFF>
        rimuovendo due blocchi adiacenti!</color>
      - "<color=#FFFFFF>Usu\u0144</color><color=#FFFFFF> mi\xF3d</color><color=#FFFFFF>,
        usuwaj\u0105c dwa s\u0105siednie bloki!</color>"
      - "<color=#FFFFFF>Radera</color><color=#FFFFFF> honung</color><color=#FFFFFF>
        genom att ta bort tv\xE5 intilliggande block!</color>"
      - "<color=#FFFFFF>\xA1Borra la</color><color=#FFFFFF> miel</color><color=#FFFFFF>
        eliminando dos bloques adyacentes!</color>"
      - "<color=#FFFFFF>\u0218terge</color><color=#FFFFFF> mierea</color><color=#FFFFFF>
        \xEEndep\u0103rt\xE2nd dou\u0103 blocuri adiacente!</color>"
      - "<color=#FFFFFF>Vyma\u017Ete</color><color=#FFFFFF> med</color><color=#FFFFFF>
        odstran\u011Bn\xEDm dvou sousedn\xEDch blok\u016F!</color>"
      - "<color=#FFFFFF>\u0423\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0434\u0432\u0430
        \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0431\u043B\u043E\u043A\u0430,
        \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0435\u0440\u0435\u0442\u044C</color><color=#FFFFFF>
        \u043C\u0451\u0434</color><color=#FFFFFF>!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips19
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5F53\u70B9\u51FB\u65B9\u5757\u65F6\uFF0C</color><color=#56A9FF>\u8774\u8776\u4F1A\u98DE\u8D77\u6765\u5E76\u963B\u6321\u5B83\u843D\u811A\u7684\u65B9\u5757!</color>"
      - "<color=#FFFFFF>\u7576\u9EDE\u64CA\u65B9\u584A\u6642\uFF0C</color><color=#56A9FF>\u8774\u8776\u6703\u98DB\u8D77\u4F86\u4E26\u963B\u64CB\u7260\u843D\u8173\u7684\u65B9\u584A!</color>"
      - <color=#FFFFFF>When you tap a block, the</color><color=#56A9FF> butterfly
        flies up and blocks the block it lands on!</color>
      - <color=#FFFFFF>Wenn du auf einen Block tippst, fliegt der</color><color=#56A9FF>
        Schmetterling hoch und blockiert den Block, auf dem er landet!</color>
      - "<color=#FFFFFF>\u30D6\u30ED\u30C3\u30AF\u3092\u30BF\u30C3\u30D7\u3059\u308B\u3068\u3001</color><color=#56A9FF>\u8776\u304C\u98DB\u3073\u4E0A\u304C\u308A\u3001\u7740\u5730\u3057\u305F\u30D6\u30ED\u30C3\u30AF\u3092\u30D6\u30ED\u30C3\u30AF\u3057\u307E\u3059\uFF01</color>"
      - "<color=#FFFFFF>\uBE14\uB85D\uC744 \uD0ED\uD558\uBA74</color><color=#56A9FF>
        \uB098\uBE44\uAC00 \uB0A0\uC544\uC62C\uB77C \uCC29\uB959\uD55C \uBE14\uB85D\uC744
        \uCC28\uB2E8\uD569\uB2C8\uB2E4!</color>"
      - <color=#FFFFFF>Lorsque vous appuyez sur un bloc, le</color><color=#56A9FF>
        papillon s'envole et bloque le bloc sur lequel il atterrit !</color>
      - <color=#FFFFFF>Quando tocchi un blocco, la</color><color=#56A9FF> farfalla
        vola su e blocca il blocco su cui atterra!</color>
      - "<color=#FFFFFF>Kiedy stukniesz w blok,</color><color=#56A9FF> motyl odlatuje
        i blokuje blok, na kt\xF3rym wyl\u0105duje!</color>"
      - "<color=#FFFFFF>N\xE4r du trycker p\xE5 ett block flyger</color><color=#56A9FF>
        fj\xE4rilen upp och blockerar det block den landar p\xE5!</color>"
      - "<color=#FFFFFF>Cuando tocas un bloque, \xA1la</color><color=#56A9FF> mariposa
        vuela y bloquea el bloque en el que aterriza!</color>"
      - "<color=#FFFFFF>C\xE2nd ape\u0219i pe un bloc,</color><color=#56A9FF> fluturarea
        zboar\u0103 \u0219i blocheaz\u0103 blocul pe care aterizeaz\u0103!</color>"
      - "<color=#FFFFFF>Kdy\u017E klepnete na blok,</color><color=#56A9FF> mot\xFDl
        vzl\xE9tne a zablokuje blok, na kter\xFD p\u0159istane!</color>"
      - "<color=#FFFFFF>\u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0442\u0435
        \u043D\u0430 \u0431\u043B\u043E\u043A,</color><color=#56A9FF> \u0431\u0430\u0431\u043E\u0447\u043A\u0430
        \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442 \u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
        \u0431\u043B\u043E\u043A, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u0441\u0430\u0434\u0438\u0442\u0441\u044F!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips2
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u60A8\u73B0\u5728\u53EF\u4EE5\u514D\u8D39\u4F7F\u7528\u8FD9\u4E9B\u52A9\u63A8\u5668!</color>"
      - "<color=#FFFFFF>\u60A8\u73FE\u5728\u53EF\u4EE5\u514D\u8CBB\u4F7F\u7528\u9019\u4E9B\u52A9\u63A8\u5668!</color>"
      - <color=#FFFFFF>You can now use these boosters for free!</color>
