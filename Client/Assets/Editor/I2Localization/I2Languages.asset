      - <color=#FFFFFF>Raccogli tre blocchi</color><color=#56A9FF> rete</color><color=#FFFFFF>
        per scacciare una farfalla!</color>
      - "<color=#FFFFFF>Zbierz trzy bloki</color><color=#56A9FF> sieci</color><color=#FFFFFF>,
        aby odstraszy\u0107 motyla!</color>"
      - "<color=#FFFFFF>Samla tre</color><color=#56A9FF> n\xE4t</color><color=#FFFFFF>block
        f\xF6r att skr\xE4mma bort en fj\xE4ril!</color>"
      - "<color=#FFFFFF>\xA1Recolecta tres bloques de</color><color=#56A9FF> red</color><color=#FFFFFF>
        para ahuyentar a una mariposa!</color>"
      - "<color=#FFFFFF>Colecteaz\u0103 trei blocuri</color><color=#56A9FF> plas\u0103</color><color=#FFFFFF>
        pentru a alunga un fluture!</color>"
      - "<color=#FFFFFF>Shrom\xE1\u017Ed\u011Bte t\u0159i bloky</color><color=#56A9FF>
        s\xEDt\u011B</color><color=#FFFFFF>, abyste zapla\u0161ili mot\xFDla!</color>"
      - "<color=#FFFFFF>\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438</color><color=#56A9FF>
        \u0441\u0430\u0447\u043A\u0430</color><color=#FFFFFF>, \u0447\u0442\u043E\u0431\u044B
        \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0434\u043D\u0443
        \u0431\u0430\u0431\u043E\u0447\u043A\u0443!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips28
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u201C\u63D0\u793A\u201D\u9053\u5177\u6BCF\u5C40\u53EA\u80FD\u4F7F\u7528<color=#56A9FF>\u4E09\u6B21</color></color>"
      - "<color=#FFFFFF>\u201C\u63D0\u793A\u201D\u9053\u5177\u6BCF\u5C40\u53EA\u80FD\u4F7F\u7528<color=#56A9FF>\u4E09\u6B21</color></color>"
      - <color=#FFFFFF>The "Hint" item can only be used <color=#56A9FF>three times</color>
        per game.</color>
      - <color=#FFFFFF>Das "Hinweis"-Item kann nur <color=#56A9FF>dreimal</color>
        pro Spiel verwendet werden.</color>
      - "<color=#FFFFFF>\u300C\u30D2\u30F3\u30C8\u300D\u30A2\u30A4\u30C6\u30E0\u306F1\u30B2\u30FC\u30E0\u3042\u305F\u308A<color=#56A9FF>3\u56DE</color>\u3057\u304B\u4F7F\u3048\u307E\u305B\u3093\u3002</color>"
      - "<color=#FFFFFF>'\uD78C\uD2B8' \uC544\uC774\uD15C\uC740 \uAC8C\uC784\uB2F9
        <color=#56A9FF>3\uD68C</color>\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</color>"
      - "<color=#FFFFFF>L'objet \"Indice\" ne peut \xEAtre utilis\xE9 que <color=#56A9FF>trois
        fois</color> par partie.</color>"
      - "<color=#FFFFFF>L'oggetto \"Suggerimento\" pu\xF2 essere usato solo <color=#56A9FF>tre
        volte</color> per partita.</color>"
      - "<color=#FFFFFF>Przedmiot \"Podpowied\u017A\" mo\u017Cna u\u017Cy\u0107 tylko
        <color=#56A9FF>trzy razy</color> na gr\u0119.</color>"
      - "<color=#FFFFFF>\"Ledtr\xE5d\"-objektet kan bara anv\xE4ndas <color=#56A9FF>tre
        g\xE5nger</color> per spel.</color>"
      - <color=#FFFFFF>El objeto "Pista" solo se puede usar <color=#56A9FF>tres veces</color>
        por partida.</color>
      - <color=#FFFFFF>Obiectul "Sugestie" poate fi folosit doar <color=#56A9FF>de
        trei ori</color> pe joc.</color>
      - "<color=#FFFFFF>P\u0159edm\u011Bt \"N\xE1pov\u011Bda\" lze pou\u017E\xEDt
        pouze <color=#56A9FF>t\u0159ikr\xE1t</color> na hru.</color>"
      - "<color=#FFFFFF>\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443 \u043C\u043E\u0436\u043D\u043E
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E <color=#56A9FF>\u0442\u0440\u0438 \u0440\u0430\u0437\u0430</color>
        \u0437\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips3
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u70B9\u51FB\u4EE5\u6536\u96C6\u65B9\u5757!</color>"
      - "<color=#FFFFFF>\u9EDE\u64CA\u4EE5\u6536\u96C6\u65B9\u584A!</color>"
      - <color=#FFFFFF>Tap to collect blocks!</color>
      - "<color=#FFFFFF>Tippe, um Bl\xF6cke zu sammeln!</color>"
      - "<color=#FFFFFF>\u30BF\u30C3\u30D7\u3057\u3066\u30D6\u30ED\u30C3\u30AF\u3092\u96C6\u3081\u3088\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uBE14\uB85D\uC744 \uC218\uC9D1\uD558\uB824\uBA74 \uD0ED\uD558\uC138\uC694!</color>"
      - <color=#FFFFFF>Appuyez pour collecter des blocs !</color>
      - <color=#FFFFFF>Tocca per raccogliere blocchi!</color>
      - "<color=#FFFFFF>Kliknij, aby zbiera\u0107 bloki!</color>"
      - "<color=#FFFFFF>Tryck f\xF6r att samla block!</color>"
      - "<color=#FFFFFF>\xA1Toca para recolectar bloques!</color>"
      - <color=#FFFFFF>Atinge pentru a colecta blocuri!</color>
      - "<color=#FFFFFF>Klepn\u011Bte pro sb\u011Br blok\u016F!</color>"
      - "<color=#FFFFFF>\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
        \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043B\u043E\u043A\u0438!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips30
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6536\u96C6\u69FD\u5185<color=#56A9FF>\u6CA1\u6709\u68CB\u5B50</color>\u7684\u65F6\u5019\u624D\u53EF\u4F7F\u7528\uFF0C\u6BCF\u5C40\u4EC5\u9650\u4F7F\u7528<color=#56A9FF>1\u6B21</color></color>"
      - "<color=#FFFFFF>\u6536\u96C6\u69FD\u5167<color=#56A9FF>\u6C92\u6709\u68CB\u5B50</color>\u7684\u6642\u5019\u624D\u53EF\u4F7F\u7528\uFF0C\u6BCF\u5C40\u50C5\u9650\u4F7F\u7528<color=#56A9FF>1\u6B21</color></color>"
      - <color=#FFFFFF>Can only be used when there are <color=#56A9FF>no pieces</color>
        in the collection slot, limited to <color=#56A9FF>1 use</color> per game.</color>
      - <color=#FFFFFF>Kann nur verwendet werden, wenn sich <color=#56A9FF>keine
        Spielsteine</color> im Sammelslot befinden, auf <color=#56A9FF>1 Verwendung</color>
        pro Spiel begrenzt.</color>
      - "<color=#FFFFFF>\u53CE\u96C6\u30B9\u30ED\u30C3\u30C8\u306B<color=#56A9FF>\u99D2\u304C\u306A\u3044</color>\u6642\u306B\u306E\u307F\u4F7F\u7528\u53EF\u80FD\u30011\u30B2\u30FC\u30E0\u3042\u305F\u308A<color=#56A9FF>1\u56DE</color>\u9650\u5B9A\u3002</color>"
      - "<color=#FFFFFF>\uC218\uC9D1 \uC2AC\uB86F\uC5D0 <color=#56A9FF>\uB9D0\uC774
        \uC5C6\uC744 \uB54C</color>\uB9CC \uC0AC\uC6A9 \uAC00\uB2A5\uD558\uBA70,
        \uAC8C\uC784\uB2F9 <color=#56A9FF>1\uD68C</color> \uC81C\uD55C.</color>"
      - "<color=#FFFFFF>Ne peut \xEAtre utilis\xE9 que lorsqu'il n'y a <color=#56A9FF>aucune
        pi\xE8ce</color> dans l'emplacement de collection, limit\xE9 \xE0 <color=#56A9FF>1
        utilisation</color> par partie.</color>"
      - "<color=#FFFFFF>Pu\xF2 essere usato solo quando non ci sono <color=#56A9FF>pezzi</color>
        nello slot di raccolta, limitato a <color=#56A9FF>1 utilizzo</color> per
        partita.</color>"
      - "<color=#FFFFFF>Mo\u017Cna u\u017Cy\u0107 tylko wtedy, gdy w slocie zbierania
        <color=#56A9FF>nie ma pionk\xF3w</color>, ograniczone do <color=#56A9FF>1
        u\u017Cycia</color> na gr\u0119.</color>"
      - "<color=#FFFFFF>Kan bara anv\xE4ndas n\xE4r det inte finns <color=#56A9FF>n\xE5gra
        pj\xE4ser</color> i insamlingsplatsen, begr\xE4nsat till <color=#56A9FF>1
        anv\xE4ndning</color> per spel.</color>"
      - "<color=#FFFFFF>Solo se puede usar cuando no hay <color=#56A9FF>piezas</color>
        en la ranura de recolecci\xF3n, limitado a <color=#56A9FF>1 uso</color> por
        partida.</color>"
      - "<color=#FFFFFF>Poate fi folosit doar c\xE2nd nu exist\u0103 <color=#56A9FF>piese</color>
        \xEEn slotul de colec\u021Bie, limitat la <color=#56A9FF>1 utilizare</color>
        pe joc.</color>"
      - "<color=#FFFFFF>Lze pou\u017E\xEDt pouze tehdy, kdy\u017E ve sb\u011Brn\xE9m
        slotu <color=#56A9FF>nejsou \u017E\xE1dn\xE9 figurky</color>, omezeno na
        <color=#56A9FF>1 pou\u017Eit\xED</color> na hru.</color>"
      - "<color=#FFFFFF>\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435,
        \u043A\u043E\u0433\u0434\u0430 \u0432 \u0441\u043B\u043E\u0442\u0435 \u0441\u0431\u043E\u0440\u0430
        <color=#56A9FF>\u043D\u0435\u0442 \u0444\u0438\u0433\u0443\u0440</color>.
        \u041C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E <color=#56A9FF>1 \u0440\u0430\u0437</color>
        \u0437\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C.</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
