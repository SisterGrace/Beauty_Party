      - "<color=#FFFFFF>\u96A3\u63A5\u3059\u308B\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3057\u3066</color><color=#FFFFFF>\u3064\u308B</color><color=#FFFFFF>\u3092\u5207\u308A\u53D6\u308D\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC778\uC811\uD55C \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uC5EC</color><color=#FFFFFF>
        \uB369\uAD74</color><color=#FFFFFF>\uC744 \uC790\uB974\uC138\uC694!</color>"
      - <color=#FFFFFF>Coupez la</color><color=#FFFFFF> vigne</color><color=#FFFFFF>
