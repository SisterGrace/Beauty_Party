    - Term: uitps_guide_tips27
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6536\u96C6\u4E09\u4E2A</color><color=#56A9FF>\u7F51\u515C</color><color=#FFFFFF>\u65B9\u5757\u53EF\u4EE5\u8D76\u8D70\u4E00\u53EA\u8774\u8776
        !</color>"
      - "<color=#FFFFFF>\u6536\u96C6\u4E09\u500B</color><color=#56A9FF>\u7DB2\u515C</color><color=#FFFFFF>\u65B9\u584A\u53EF\u4EE5\u8D95\u8D70\u4E00\u96BB\u8774\u8776
        !</color>"
      - <color=#FFFFFF>Collect three</color><color=#56A9FF> net</color><color=#FFFFFF>
        blocks to scare away a butterfly!</color>
      - "<color=#FFFFFF>Sammle drei</color><color=#56A9FF> Netz</color><color=#FFFFFF>-Bl\xF6cke,
        um einen Schmetterling zu verscheuchen!</color>"
      - "<color=#FFFFFF>3\u3064\u306E</color><color=#56A9FF>\u7DB2</color><color=#FFFFFF>\u30D6\u30ED\u30C3\u30AF\u3092\u96C6\u3081\u3066\u8776\u3092\u8FFD\u3044\u6255\u304A\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC138 \uAC1C\uC758</color><color=#56A9FF> \uADF8\uBB3C</color><color=#FFFFFF>
        \uBE14\uB85D\uC744 \uBAA8\uC544 \uB098\uBE44\uB97C \uCAD3\uC544\uB0B4\uC138\uC694!</color>"
      - <color=#FFFFFF>Collectez trois blocs de</color><color=#56A9FF> filet</color><color=#FFFFFF>
