    - Term: uitps_setting_hattip
      TermType: 0
      Description: 
      Languages:
      - "<color=#446ED7>\u5C0F\u4E11\u5E3D</color> <color=#A24621>\u53EF\u4EE5\u6253\u4E71\u65B9\u5757\u5E76\u91CD\u65B0\u6392\u5217!</color>"
      - "<color=#446ED7>\u5C0F\u4E11\u5E3D</color> <color=#A24621>\u53EF\u4EE5\u6253\u4E82\u65B9\u584A\u4E26\u91CD\u65B0\u6392\u5217!</color>"
      - <color=#446ED7>Jester's Hat</color> <color=#A24621>can shuffle and rearrange
