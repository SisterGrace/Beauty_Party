      Languages_Touch: []
    - Term: uitps_guide_tips23
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5728\u65F6\u95F4\u8017\u5C3D\u524D\u70B9\u51FB</color><color=#FFFFFF>\u70B8\u5F39</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u5728\u6642\u9593\u8017\u76E1\u524D\u9EDE\u64CA</color><color=#FFFFFF>\u70B8\u5F48</color><color=#FFFFFF>!</color>"
