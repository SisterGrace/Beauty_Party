    - Term: uitps_guide_tips25
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u5728\u91D1\u8272\u5305\u88C5\u5B8C\u5168\u6D88\u5931\u4E4B\u524D\u6536\u96C6\u5B83!</color>"
      - "<color=#FFFFFF>\u5728\u91D1\u8272\u5305\u88DD\u5B8C\u5168\u6D88\u5931\u4E4B\u524D\u6536\u96C6\u5B83!</color>"
      - <color=#FFFFFF>Collect the golden wrapper before it disappears completely!</color>
      - "<color=#FFFFFF>Sammle die goldene Verpackung, bevor sie vollst\xE4ndig verschwindet!</color>"
      - "<color=#FFFFFF>\u91D1\u8272\u306E\u5305\u88C5\u304C\u5B8C\u5168\u306B\u6D88\u3048\u308B\u524D\u306B\u96C6\u3081\u3088\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uD669\uAE08 \uD3EC\uC7A5\uC774 \uC644\uC804\uD788 \uC0AC\uB77C\uC9C0\uAE30
        \uC804\uC5D0 \uC218\uC9D1\uD558\uC138\uC694!</color>"
      - "<color=#FFFFFF>Collectez l'emballage dor\xE9 avant qu'il ne disparaisse
        compl\xE8tement !</color>"
      - <color=#FFFFFF>Raccogli l'involucro dorato prima che scompaia completamente!</color>
      - "<color=#FFFFFF>Zbierz z\u0142ote opakowanie, zanim ca\u0142kowicie zniknie!</color>"
      - "<color=#FFFFFF>Samla det gyllene omslaget innan det f\xF6rsvinner helt!</color>"
      - "<color=#FFFFFF>\xA1Recoge el envoltorio dorado antes de que desaparezca
        por completo!</color>"
      - "<color=#FFFFFF>Colecteaz\u0103 ambalajul auriu \xEEnainte s\u0103 dispar\u0103
        complet!</color>"
      - "<color=#FFFFFF>Seberte zlat\xFD obal, ne\u017E \xFApln\u011B zmiz\xED!</color>"
      - "<color=#FFFFFF>\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u043E\u043B\u043E\u0442\u0443\u044E
        \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0443 \u0434\u043E \u0442\u043E\u0433\u043E,
        \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
        \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442!</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips26
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u70B9\u51FB\u8FD9\u91CC\u586B\u5199\u60A8\u7684\u8D44\u6599!</color>"
      - "<color=#FFFFFF>\u9EDE\u64CA\u9019\u88E1\u586B\u5BEB\u60A8\u7684\u8CC7\u6599!</color>"
      - <color=#FFFFFF>Tap here to fill in your information!</color>
