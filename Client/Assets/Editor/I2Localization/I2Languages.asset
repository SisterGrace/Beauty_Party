      - "<color=#56A9FF>\u989D\u5916\u69FD</color><color=#FFFFFF>\u4E3A\u60A8\u63D0\u4F9B\u4E00\u4E2A\u989D\u5916\u7684\u67B6\u5B50\u69FD!</color>"
      - "<color=#56A9FF>\u984D\u5916\u69FD</color><color=#FFFFFF>\u70BA\u60A8\u63D0\u4F9B\u4E00\u500B\u984D\u5916\u7684\u67B6\u5B50\u69FD!</color>"
      - <color=#56A9FF>Extra Slot</color><color=#FFFFFF> gives you an additional
