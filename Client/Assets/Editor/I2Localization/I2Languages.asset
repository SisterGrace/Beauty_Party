      Languages_Touch: []
    - Term: uitps_guide_tips16
      TermType: 0
      Description: 
      Languages:
      - "<color=#56A9FF>\u900F\u660E\u8D1D\u58F3</color><color=#FFFFFF>\u5728\u60A8\u79FB\u5F00\u4E0B\u65B9\u7684\u65B9\u5757\u65F6\u4F1A\u5410\u51FA\u65B0\u7684\u65B9\u5757.</color>"
      - "<color=#56A9FF>\u900F\u660E\u8C9D\u6BBC</color><color=#FFFFFF>\u5728\u60A8\u79FB\u958B\u4E0B\u65B9\u7684\u65B9\u584A\u6642\u6703\u5410\u51FA\u65B0\u7684\u65B9\u584A.</color>"
      - <color=#56A9FF>Transparent Shell</color><color=#FFFFFF> spits out new blocks
        when you remove the ones below it.</color>
      - "<color=#56A9FF>Transparente Muschel</color><color=#FFFFFF> spuckt neue Bl\xF6cke
        aus, wenn du die darunter entfernst.</color>"
      - "<color=#56A9FF>\u900F\u660E\u306A\u8C9D\u6BBB</color><color=#FFFFFF>\u306F\u4E0B\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u6D88\u3059\u3068\u65B0\u3057\u3044\u30D6\u30ED\u30C3\u30AF\u3092\u5410\u304D\u51FA\u3057\u307E\u3059\u3002</color>"
      - "<color=#56A9FF>\uD22C\uBA85 \uC870\uAC1C</color><color=#FFFFFF>\uB294 \uC544\uB798
        \uBE14\uB85D\uC744 \uC81C\uAC70\uD558\uBA74 \uC0C8\uB85C\uC6B4 \uBE14\uB85D\uC744
        \uBC49\uC5B4\uB0C5\uB2C8\uB2E4.</color>"
      - <color=#56A9FF>Coquille transparente</color><color=#FFFFFF> crache de nouveaux
        blocs lorsque vous enlevez ceux du dessous.</color>
      - <color=#56A9FF>Guscio trasparente</color><color=#FFFFFF> sputa nuovi blocchi
        quando rimuovi quelli sottostanti.</color>
      - "<color=#56A9FF>Przezroczysta muszla</color><color=#FFFFFF> wypluwa nowe
        bloki, gdy usuniesz te pod ni\u0105.</color>"
      - "<color=#56A9FF>Genomskinligt sn\xE4ckskal</color><color=#FFFFFF> spottar
        ut nya block n\xE4r du tar bort de under.</color>"
      - <color=#56A9FF>Concha transparente</color><color=#FFFFFF> escupe nuevos bloques
        cuando quitas los de abajo.</color>
      - "<color=#56A9FF>Coaja transparent\u0103</color><color=#FFFFFF> scuip\u0103
        blocuri noi c\xE2nd \xEEndep\u0103rtezi cele de dedesubt.</color>"
      - "<color=#56A9FF>Pr\u016Fhlast\xE1 lastura</color><color=#FFFFFF> vyplivne
        nov\xE9 bloky, kdy\u017E odstran\xEDte ty pod n\xED.</color>"
      - "<color=#56A9FF>\u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430\u044F
        \u0440\u0430\u043A\u0443\u0448\u043A\u0430</color><color=#FFFFFF> \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
        \u043D\u043E\u0432\u044B\u0435 \u0431\u043B\u043E\u043A\u0438, \u043A\u043E\u0433\u0434\u0430
        \u0432\u044B \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0431\u043B\u043E\u043A\u0438
        \u043F\u043E\u0434 \u043D\u0435\u0439.</color>"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: uitps_guide_tips17
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u70B9\u51FB\u4EFB\u610F\u65B9\u5757\u6765\u65CB\u8F6C</color><color=#FFFFFF>\u53CC\u9762\u724C</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u9EDE\u64CA\u4EFB\u610F\u65B9\u584A\u4F86\u65CB\u8F49</color><color=#FFFFFF>\u96D9\u9762\u724C</color><color=#FFFFFF>!</color>"
      - <color=#FFFFFF>Tap any block to rotate the</color><color=#FFFFFF> Double-Sided
        Tile</color><color=#FFFFFF>!</color>
      - <color=#FFFFFF>Tippe auf einen beliebigen Block, um die</color><color=#FFFFFF>
        doppelseitige Kachel</color><color=#FFFFFF> zu drehen!</color>
      - "<color=#FFFFFF>\u4EFB\u610F\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u30BF\u30C3\u30D7\u3057\u3066</color><color=#FFFFFF>\u4E21\u9762\u30BF\u30A4\u30EB</color><color=#FFFFFF>\u3092\u56DE\u8EE2\u3055\u305B\u3088\u3046\uFF01</color>"
      - "<color=#FFFFFF>\uC544\uBB34 \uBE14\uB85D\uC744 \uD0ED\uD558\uC5EC</color><color=#FFFFFF>
        \uC591\uBA74 \uD0C0\uC77C</color><color=#FFFFFF>\uC744 \uD68C\uC804\uD558\uC138\uC694!</color>"
      - <color=#FFFFFF>Appuyez sur n'importe quel bloc pour faire pivoter la</color><color=#FFFFFF>
        tuile double face</color><color=#FFFFFF> !</color>
      - <color=#FFFFFF>Tocca qualsiasi blocco per ruotare la</color><color=#FFFFFF>
        tessera a doppia faccia</color><color=#FFFFFF>!</color>
      - "<color=#FFFFFF>Kliknij dowolny blok, aby obr\xF3ci\u0107</color><color=#FFFFFF>
        dwustronn\u0105 p\u0142ytk\u0119</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>Tryck p\xE5 valfritt block f\xF6r att rotera</color><color=#FFFFFF>
        dubbelsidiga plattan</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\xA1Toca cualquier bloque para girar la</color><color=#FFFFFF>
        ficha de doble cara</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>Atinge orice bloc pentru a roti</color><color=#FFFFFF> placa
        cu dou\u0103 fe\u021Be</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>Klepn\u011Bte na libovoln\xFD blok a oto\u010Dte</color><color=#FFFFFF>
        dvoustrannou dla\u017Edici</color><color=#FFFFFF>!</color>"
      - "<color=#FFFFFF>\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439
        \u0431\u043B\u043E\u043A, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C</color><color=#FFFFFF>
        \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044E\u044E
        \u043A\u0430\u0440\u0442\u0443</color><color=#FFFFFF>!</color>"
