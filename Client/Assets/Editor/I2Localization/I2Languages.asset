      Languages_Touch: []
    - Term: uitps_guide_tips15
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u4E24\u4E2A\u5E26\u6709</color><color=#56A9FF>\u62C9\u94FE</color><color=#FFFFFF>\u7684\u65B9\u5757\u5C06\u4E00\u8D77\u79FB\u52A8!</color>"
      - "<color=#FFFFFF>\u5169\u500B\u5E36\u6709</color><color=#56A9FF>\u62C9\u934A</color><color=#FFFFFF>\u7684\u65B9\u584A\u5C07\u4E00\u8D77\u79FB\u52D5!</color>"
      - <color=#FFFFFF>Two blocks with</color><color=#56A9FF> zippers</color><color=#FFFFFF>
        will move together!</color>
      - "<color=#FFFFFF>Zwei Bl\xF6cke mit</color><color=#56A9FF> Rei\xDFverschl\xFCssen</color><color=#FFFFFF>
        bewegen sich zusammen!</color>"
      - "<color=#FFFFFF>\u30B8\u30C3\u30D1\u30FC\u304C\u3064\u3044\u305F2\u3064\u306E\u30D6\u30ED\u30C3\u30AF\u306F\u4E00\u7DD2\u306B\u52D5\u304F\uFF01</color>"
      - "<color=#FFFFFF>\uC9C0\uD37C\uAC00 \uB2EC\uB9B0 \uB450 \uBE14\uB85D\uC740
        \uD568\uAED8 \uC774\uB3D9\uD569\uB2C8\uB2E4!</color>"
      - "<color=#FFFFFF>Deux blocs avec des</color><color=#56A9FF> fermetures \xE9clair</color><color=#FFFFFF>
        se d\xE9placent ensemble !</color>"
      - <color=#FFFFFF>Due blocchi con</color><color=#56A9FF> cerniere</color><color=#FFFFFF>
        si muovono insieme!</color>
      - "<color=#FFFFFF>Dwa bloki z</color><color=#56A9FF> suwakami</color><color=#FFFFFF>
        b\u0119d\u0105 porusza\u0107 si\u0119 razem!</color>"
      - "<color=#FFFFFF>Tv\xE5 block med</color><color=#56A9FF> blixtl\xE5s</color><color=#FFFFFF>
        r\xF6r sig tillsammans!</color>"
      - "<color=#FFFFFF>\xA1Dos bloques con</color><color=#56A9FF> cremalleras</color><color=#FFFFFF>
        se mover\xE1n juntos!</color>"
      - "<color=#FFFFFF>Dou\u0103 blocuri cu</color><color=#56A9FF> fermoare</color><color=#FFFFFF>
        se vor mi\u0219ca \xEEmpreun\u0103!</color>"
      - "<color=#FFFFFF>Dva bloky s</color><color=#56A9FF> zipy</color><color=#FFFFFF>
        se budou pohybovat spole\u010Dn\u011B!</color>"
      - "<color=#FFFFFF>\u0414\u0432\u0430 \u0431\u043B\u043E\u043A\u0430 \u0441</color><color=#56A9FF>
        \u043C\u043E\u043B\u043D\u0438\u0435\u0439</color><color=#FFFFFF> \u0431\u0443\u0434\u0443\u0442
