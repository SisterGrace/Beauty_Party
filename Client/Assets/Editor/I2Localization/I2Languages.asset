      - "<color=#446ED7>\u9B54\u6CD5\u306E\u6756</color> <color=#A24621>\u306F\u30D7\u30EC\u30A4\u30A8\u30EA\u30A2\u304B\u3089\u4E00\u7D44\u306E\u30D6\u30ED\u30C3\u30AF\u3092\u524A\u9664\u3067\u304D\u307E\u3059\uFF01</color>"
