      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u6536\u96C6</color><color=#56A9FF>\u4E09\u4E2A\u65B9\u5757</color><color=#FFFFFF>\u4EE5\u6D88\u9664\u5B83\u4EEC!</color>"
      - "<color=#FFFFFF>\u6536\u96C6</color><color=#56A9FF>\u4E09\u500B\u65B9\u584A</color><color=#FFFFFF>\u4EE5\u6D88\u9664\u5B83\u5011!</color>"
