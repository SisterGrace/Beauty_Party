      Languages_Touch: []
    - Term: uitps_guide_tips13
      TermType: 0
      Description: 
      Languages:
      - "<color=#FFFFFF>\u9B54\u6756\u53EF\u6E05\u9664\u4E09\u4E2A\u76F8\u540C\u7684\u65B9\u5757!</color>"
      - "<color=#FFFFFF>\u9B54\u6756\u53EF\u6E05\u9664\u4E09\u500B\u76F8\u540C\u7684\u65B9\u584A!</color>"
      - <color=#FFFFFF>Wand can clear three identical blocks!</color>
      - "<color=#FFFFFF>Zauberstab kann drei identische Bl\xF6cke entfernen!</color>"
      - "<color=#FFFFFF>\u9B54\u6CD5\u306E\u6756\u3067\u540C\u3058\u30D6\u30ED\u30C3\u30AF\u30923\u3064\u6D88\u53BB\uFF01</color>"
      - "<color=#FFFFFF>\uB9C8\uBC95 \uC9C0\uD321\uC774\uB85C \uB3D9\uC77C\uD55C
